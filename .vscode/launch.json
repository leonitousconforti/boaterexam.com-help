{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chrome (Extension Loaded)",
            "type": "chrome",
            "request": "launch",
            "url": "https://www.boaterexam.com/",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "stable",
            "runtimeArgs": ["--load-extension=${workspaceFolder}"]
        }
    ]
}
