{
    "$schema": "https://json.schemastore.org/chrome-manifest.json",
    "manifest_version": 3,
    "name": "boaterexam.com-help",
    "description": "Automates selected boaterexam.com pages.",
    "version": "0.0.0",
    "content_scripts": [
        {
            "matches": ["https://www.boaterexam.com/quizzes/*"],
            "js": ["exam.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.boaterexam.com/course/content/*"],
            "js": ["course-content.js"],
            "run_at": "document_idle"
        }
    ]
}
